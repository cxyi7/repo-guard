{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxyi7.github.io/repo-guard/repo-guard-json-v1.schema.json",
  "title": "repo-guard external gate report v1",
  "$comment": "外部门禁协议字段和机器枚举保持稳定；repo-guard 在展示边界提供中文说明，第三方原始诊断只作为明确标记的定位信息保留。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "status", "summary", "findings", "metrics", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gateId": { "type": "string", "pattern": "^project\\.[a-z][a-z0-9-]*$" },
    "status": { "type": "string", "enum": ["passed", "violation"] },
    "summary": { "type": "string", "pattern": "\\S" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "message"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "\\S" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "pattern": "\\S" },
          "location": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "endColumn": { "type": "integer", "minimum": 1 }
            }
          },
          "evidence": { "type": ["string", "null"] },
          "remediation": { "type": ["string", "null"] }
        }
      }
    },
    "metrics": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "number" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string", "pattern": "^reports/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$" },
          "type": { "type": "string", "pattern": "\\S" },
          "description": { "type": ["string", "null"] }
        }
      }
    }
  }
}
