{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-guard.dev/operations.schema.json",
  "title": "repo-guard 独立运维配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2,
      "description": "配置版本，必须为 2。"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "是否显式启用运维流水线；缺省关闭。"
    },
    "provider": {
      "const": "gitlab",
      "default": "gitlab",
      "description": "GitLab 流水线生成器；蓝绿执行入口也可手动调用，无需 GitLab 运行时。"
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "启用整条运维流水线的企业微信成功、失败及尽力取消通知；成功和失败通知覆盖与质量、构建相同的合并请求及分支流水线。通知失败不改变质量或部署结果，凭据只从 CI 环境变量读取；配置更新后需重新执行 ops install。"
        }
      }
    },
    "projects": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/project"
      },
      "description": "键必须对应质量配置中显式声明的项目标识。"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$",
      "description": "项目 package.json 中已声明的脚本名；不得填写整条命令。"
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$",
      "description": "相对于应用目录的具体文件或目录；不支持通配符、空格、上级目录或符号链接，构建后必须存在且非空。"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branches"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/script"
        },
        "production": {
          "type": "boolean",
          "default": true,
          "description": "true 为生产环境且必须手动触发；false 为测试环境。"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "description": "允许部署的明确分支名；不支持通配符或表达式。"
        },
        "blueGreen": {
          "$ref": "#/$defs/blueGreen"
        }
      },
      "oneOf": [
        {
          "required": [
            "script"
          ],
          "not": {
            "required": [
              "blueGreen"
            ]
          }
        },
        {
          "required": [
            "blueGreen"
          ],
          "not": {
            "required": [
              "script"
            ]
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "buildScript": {
          "$ref": "#/$defs/script"
        },
        "artifactPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "environments": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environment"
          }
        },
        "verifyDelivery": {
          "type": "boolean",
          "default": false,
          "description": "构建部署前是否使用独立 delivery-check 入口复核最终交付条件。"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "enum": [
                "mvn",
                "./mvnw"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "command",
            "args"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "artifactPaths"
            ],
            "properties": {
              "artifactPaths": {
                "minItems": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "buildScript"
                ],
                "not": {
                  "required": [
                    "build"
                  ]
                }
              },
              {
                "required": [
                  "build"
                ],
                "not": {
                  "required": [
                    "buildScript"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "blueGreen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "network": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "default": "Dockerfile"
        },
        "healthUrl": {
          "type": "string",
          "minLength": 1,
          "description": "正式入口的 /api/health 地址；只接受 HTTP 或 HTTPS，无认证信息、查询参数或片段。"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "default": 120
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": "应用环境变量到执行环境变量名称的映射，不填写秘密值。"
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          },
          "description": "默认关闭，只回退应用并保留当前数据。启用后备份已声明的 MySQL、上传目录和 Redis；至少声明一种数据资源。"
        },
        "uploads": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^/(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*$"
                },
                "target": {
                  "type": "string",
                  "pattern": "^/(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*$"
                }
              },
              "required": [
                "source",
                "target"
              ]
            }
          ]
        },
        "mysql": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "container": {
                  "$ref": "#/$defs/identifier"
                },
                "database": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
                },
                "defaultsFile": {
                  "type": "string",
                  "pattern": "^/(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*$"
                }
              },
              "required": [
                "container",
                "database",
                "defaultsFile"
              ]
            }
          ]
        },
        "redis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "container": {
                  "$ref": "#/$defs/identifier"
                },
                "volume": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "required": [
                "container",
                "volume"
              ]
            }
          ]
        },
        "proxyImage": {
          "type": "string",
          "minLength": 1,
          "default": "nginx:1.28-alpine"
        },
        "helperImage": {
          "type": "string",
          "minLength": 1,
          "default": "node:22.23.2-alpine"
        }
      },
      "required": [
        "name",
        "network",
        "port",
        "containerPort",
        "healthUrl"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "backup"
            ],
            "properties": {
              "backup": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "mysql"
                ],
                "properties": {
                  "mysql": {
                    "type": "object"
                  }
                }
              },
              {
                "required": [
                  "uploads"
                ],
                "properties": {
                  "uploads": {
                    "type": "object"
                  }
                }
              },
              {
                "required": [
                  "redis"
                ],
                "properties": {
                  "redis": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
