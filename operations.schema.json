{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-guard.dev/operations.schema.json",
  "title": "repo-guard 独立运维配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2, "description": "配置版本，必须为 2。" },
    "enabled": { "type": "boolean", "default": false, "description": "是否显式启用运维流水线；缺省关闭。" },
    "provider": { "const": "gitlab", "default": "gitlab", "description": "当前仅支持 GitLab。" },
    "projects": {
      "type": "object",
      "default": {},
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/project" },
      "description": "键必须对应质量配置中显式声明的项目标识。"
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "script": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$", "description": "项目 package.json 中已声明的脚本名；不得填写整条命令。" },
    "artifactPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$",
      "description": "相对于应用目录的具体文件或目录；不支持通配符、空格、上级目录或符号链接，构建后必须存在且非空。"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "branches"],
      "properties": {
        "script": { "$ref": "#/$defs/script" },
        "production": { "type": "boolean", "default": true, "description": "true 为生产环境且必须手动触发；false 为测试环境。" },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
          "description": "允许部署的明确分支名；不支持通配符或表达式。"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "qualityProfile": { "enum": ["full", "release-ready"], "default": "full" },
        "buildScript": { "$ref": "#/$defs/script" },
        "artifactPaths": { "type": "array", "items": { "$ref": "#/$defs/artifactPath" } },
        "environments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/environment" }
        }
      },
      "allOf": [{
        "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
        "then": { "required": ["buildScript", "artifactPaths"], "properties": { "artifactPaths": { "minItems": 1 } } }
      }]
    }
  }
}
