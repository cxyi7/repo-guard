{
  "name": "@cxyi7/repo-guard",
  "version": "2.1.0",
  "description": "面向 AI 与团队开发的工程质量门禁，支持显式配置前端、Node 后端与 Java Maven 检查",
  "homepage": "https://github.com/cxyi7/repo-guard#readme",
  "bugs": {
    "url": "https://github.com/cxyi7/repo-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxyi7/repo-guard.git"
  },
  "keywords": [
    "git-hooks",
    "gitlab-ci",
    "ci-cd",
    "ci-gate",
    "repository-policy",
    "protected-files",
    "file-placement",
    "dependency-cruiser",
    "dependency-governance",
    "architecture",
    "structured-exceptions",
    "vue-security",
    "no-eval",
    "noopener",
    "typescript",
    "type-checking",
    "vitest",
    "unit-testing",
    "coverage",
    "changed-line-coverage",
    "mutation-testing",
    "stryker",
    "bundle-size",
    "build-budget",
    "mini-program",
    "axios",
    "api-performance",
    "k6",
    "load-testing",
    "knip",
    "dead-code",
    "image-optimization",
    "unused-assets",
    "webp",
    "sharp",
    "svgo",
    "lighthouse",
    "stylelint",
    "style-complexity",
    "style-governance",
    "prettier",
    "internal-cli"
  ],
  "type": "module",
  "bin": {
    "repo-guard": "bin/repo-guard.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./config.schema.json": "./config.schema.json",
    "./project.schema.json": "./project.schema.json",
    "./operations.schema.json": "./operations.schema.json",
    "./ui-token-manifest.schema.json": "./ui-token-manifest.schema.json",
    "./external-report.schema.json": "./external-report.schema.json",
    "./api-performance-config.schema.json": "./api-performance-config.schema.json",
    "./k6-load-config.schema.json": "./k6-load-config.schema.json",
    "./gate-result.schema.json": "./gate-result.schema.json",
    "./delivery.schema.json": "./delivery.schema.json",
    "./delivery-contract.schema.json": "./delivery-contract.schema.json",
    "./vite": "./src/integrations/build-artifacts/vite-plugin.js"
  },
  "files": [
    "bin",
    "docs",
    "scripts/check-syntax.js",
    "skills",
    "src",
    "config.schema.json",
    "project.schema.json",
    "operations.schema.json",
    "ui-token-manifest.schema.json",
    "external-report.schema.json",
    "api-performance-config.schema.json",
    "k6-load-config.schema.json",
    "gate-result.schema.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "delivery.schema.json",
    "delivery-contract.schema.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "check": "npm run lint && npm run architecture:check && node scripts/check-syntax.js && node scripts/check-user-facing-language.js",
    "language:prune-baseline": "node scripts/prune-user-facing-language-baseline.js",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
