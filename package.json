{
  "name": "@cxyi7/repo-guard",
  "version": "1.4.38",
  "description": "Structured Git and GitLab CI policy gates for Vue security, accessibility, code quality, dependencies, architecture, builds, coverage, and tests",
  "keywords": [
    "git-hooks",
    "gitlab-ci",
    "ci-gate",
    "repository-policy",
    "protected-files",
    "file-placement",
    "dependency-cruiser",
    "dependency-governance",
    "architecture",
    "structured-exceptions",
    "vue-security",
    "no-eval",
    "vue-accessibility",
    "noopener",
    "typescript",
    "type-checking",
    "vitest",
    "unit-testing",
    "coverage",
    "changed-line-coverage",
    "lighthouse",
    "stylelint",
    "style-complexity",
    "style-governance",
    "prettier",
    "internal-cli"
  ],
  "type": "module",
  "bin": {
    "repo-guard": "bin/repo-guard.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./config.schema.json": "./config.schema.json",
    "./external-report.schema.json": "./external-report.schema.json",
    "./gate-result.schema.json": "./gate-result.schema.json"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "config.schema.json",
    "external-report.schema.json",
    "gate-result.schema.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err-long src",
    "check": "npm run lint && npm run architecture:check && node scripts/check-syntax.js",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.0",
    "lint-staged": "15.5.2",
    "micromatch": "4.0.8"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4 <5",
    "@eslint/js": ">=8.57",
    "@lhci/cli": ">=0.13 <0.16",
    "@vue/test-utils": ">=2 <3",
    "axe-core": ">=4 <5",
    "cypress-axe": ">=1 <2",
    "dependency-cruiser": ">=16 <19",
    "eslint": ">=8",
    "eslint-plugin-vue": ">=9.28",
    "jest-axe": ">=7 <12",
    "prettier": ">=3 <4",
    "stylelint": ">=16 <18",
    "typescript-eslint": ">=8",
    "vitest": ">=1 <5",
    "vitest-axe": ">=0.1 <1"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    },
    "@lhci/cli": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "dependency-cruiser": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    },
    "cypress-axe": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "vitest-axe": {
      "optional": true
    },
    "jest-axe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "stylelint": "16.26.1"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "UNLICENSED",
  "private": false
}
