{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxyi7.github.io/repo-guard/api-performance-config.schema.json",
  "title": "repo-guard Axios 接口性能测试配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "client", "scenarios", "thresholds"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrlEnv", "allowedHosts", "confirmationEnv"],
      "properties": {
        "baseUrlEnv": { "$ref": "#/$defs/environmentName" },
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^*/:@]+$"
          }
        },
        "confirmationEnv": { "$ref": "#/$defs/environmentName" },
        "requireHttps": { "const": true }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "$ref": "#/$defs/modulePath" },
        "exportName": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/modulePath" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmupIterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "iterations": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowWrites": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "modulePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+\\.mjs$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p95Ms", "p99Ms", "errorRate"],
      "properties": {
        "p95Ms": { "type": "number", "minimum": 1, "maximum": 300000 },
        "p99Ms": { "type": "number", "minimum": 1, "maximum": 300000 },
        "errorRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
