{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@cxyi7/repo-guard/ui-token-manifest.schema.json",
  "title": "repo-guard UI Token Manifest",
  "description": "由项目生成并提交的样式 Token 契约。来源文件指纹用于证明 Manifest 与 CSS、Sass、Less 设计来源处于同一快照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources",
    "tokens"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*",
            "description": "应用目录内的 Token 来源文件。"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "来源文件当前内容的小写 SHA-256。"
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "color",
              "spacing",
              "font-family",
              "font-size",
              "line-height",
              "font-weight",
              "radius",
              "shadow",
              "z-index",
              "breakpoint",
              "animation-duration",
              "icon-size"
            ]
          },
          "aliases": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "css": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              },
              "sass": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              },
              "less": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "css"
                ],
                "properties": {
                  "css": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "sass"
                ],
                "properties": {
                  "sass": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "less"
                ],
                "properties": {
                  "less": {
                    "minItems": 1
                  }
                }
              }
            ],
            "description": "CSS 普通别名使用无回退值的完整 var(--name)，变量名只含字母、数字、下划线或连字符；CSS 断点别名使用大于零的 px、em 或 rem 长度。Sass 与 Less 别名按完整表达式匹配。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "const": "breakpoint"
                }
              },
              "required": [
                "category"
              ]
            },
            "then": {
              "properties": {
                "aliases": {
                  "properties": {
                    "css": {
                      "items": {
                        "pattern": "^(?!0*(?:\\.0+)?(?:px|em|rem)$)(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:px|em|rem)$"
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "aliases": {
                  "properties": {
                    "css": {
                      "items": {
                        "pattern": "^var\\(--[a-zA-Z0-9_-]+\\)$"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
